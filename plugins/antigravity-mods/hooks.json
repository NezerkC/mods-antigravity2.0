{
  "antigravity-mods-hook": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/context-hook.mjs",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/context-hook.mjs --post",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/context-hook.mjs --stop",
        "timeout": 10
      }
    ]
  }
}
