{
  "name": "mods-antigravity2.0",
  "version": "2.0.0",
  "description": "Extensible UI Mod Framework and Specialists for Google Antigravity 2.0",
  "type": "module",
  "main": "framework/index.js",
  "scripts": {
    "build": "node build.js",
    "deploy": "node build.js",
    "package": "node tools/package_release.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/functional/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:functional": "node --test tests/functional/*.test.mjs",
    "daemon": "node framework/daemon.js",
    "daemon:start": "node framework/daemon.js --start",
    "daemon:stop": "node framework/daemon.js --stop",
    "daemon:status": "node framework/daemon.js --status",
    "daemon:install": "node framework/daemon.js --install",
    "daemon:uninstall": "node framework/daemon.js --uninstall",
    "probe": "node tools/probe.js",
    "probe:dom": "node tools/probe.js dom",
    "probe:proc": "node tools/probe.js processes",
    "probe:cdp": "node tools/probe.js cdp"
  },
  "author": "Victor Manuel Martinez Munoz",
  "license": "MIT"
}
